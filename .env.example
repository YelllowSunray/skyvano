# Copy to .env.local. Never commit real tokens. Restart `next dev` after saving.

# ===== Required =====
SHOPIFY_STORE_DOMAIN=syi12w-cq.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Buyer market for inventory. Defaults to NL — the store's only market.
SHOPIFY_STORE_COUNTRY=NL

# Shopify Admin → Sales channels → Headless → your storefront → API keys
# → Storefront API → Private access token. Starts with shpat_
# Tick "Read product inventory" on that same page so stock 0 shows Sold out.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# ===== Optional =====
# Public token from the same Headless page. Only needed if the private
# token is unavailable; skip it when the private token above is filled.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API — not needed to render the store. Only unlocks per-location
# inventory, orders, customers, and draft products.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Only when we add webhooks
SHOPIFY_WEBHOOK_SECRET=

# Resend — contact form. Create a key at https://resend.com/api-keys
# Verify skyvano.com at https://resend.com/domains then use info@skyvano.com
RESEND_API_KEY=
# Optional. Defaults to Skyvano <info@skyvano.com>
RESEND_FROM=
# Optional. Defaults to info@skyvano.com
CONTACT_TO=
